# --- Backend ---
NODE_ENV=development
BACKEND_HOST=bbstat.localhost
BACKEND_PORT=8443

# Path to local TLS material (relative to repo root). Default works out of the box.
TLS_KEY_PATH=etc/tls/server.key
TLS_CERT_PATH=etc/tls/server.crt

# Postgres
DATABASE_URL=postgres://bbstat:bbstat@localhost:5432/bbstat

# Redis (user summary cache only)
REDIS_URL=redis://localhost:6379

# BitBucket API (ingest-time only — never proxied to the request path)
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=
BITBUCKET_AUTH_EMAIL=
BITBUCKET_AUTH_TOKEN=
# Soft cap on outbound BitBucket calls per rolling hour (BB Cloud limit ≈ 1000).
BITBUCKET_HOURLY_CALL_BUDGET=800

# Curated tracked-repo seed list. Comma-separated <workspace>/<slug> pairs.
# Example: tigerit/boing-server,tigerit/boing-relay,tigerit/boing-instances
SEED_TRACKED_REPOS=

# Cron schedules (override only if the defaults are too tight for your setup).
# SYNC_MEMBERS_CRON=*/10 * * * *
# SYNC_REPOS_CRON=*/5 * * * *
# SYNC_COMMITS_CRON=*/15 * * * *

# First-run cap on commit backfill per repo (no effect on delta runs).
# COMMITS_BACKFILL_MAX_PAGES=5
# COMMITS_BACKFILL_SINCE=               # ISO 8601 (e.g. 2026-01-01) or empty
# COMMIT_SYNC_CONCURRENCY=3
# COMMIT_SYNC_BUDGET_THRESHOLD=20

# --- Frontend ---
VITE_API_BASE_URL=https://bbstat.localhost:8443
VITE_DEV_PORT=5173
