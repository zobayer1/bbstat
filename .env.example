# --- Backend ---
NODE_ENV=development
BACKEND_HOST=bbstat.localhost
BACKEND_PORT=8443

# Path to local TLS material (relative to repo root). Default works out of the box.
TLS_KEY_PATH=etc/tls/server.key
TLS_CERT_PATH=etc/tls/server.crt

# Postgres
# Container exposes :5432 INSIDE Docker but binds 127.0.0.1:15432 on the host
# (default). Override via POSTGRES_HOST_PORT below if you need a different port.
DATABASE_URL=postgres://bbstat:bbstat@localhost:15432/bbstat

# Redis (user summary cache only) — same host-port pattern.
REDIS_URL=redis://localhost:16379

# Host-side port bindings for the docker-compose dev stack. Picked to avoid
# collisions with a host-installed postgres/redis or other projects' test
# containers bound to the standard ports. If you change these, also update
# the host:port in DATABASE_URL / REDIS_URL above.
# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379

# BitBucket API (ingest-time only — never proxied to the request path)
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=
BITBUCKET_AUTH_EMAIL=
BITBUCKET_AUTH_TOKEN=
# Soft cap on outbound BitBucket calls per rolling hour (BB Cloud limit ≈ 1000).
BITBUCKET_HOURLY_CALL_BUDGET=800

# Path to the curated tracked-repo seed list (YAML). Relative paths resolve
# against the repo root. If unset, defaults to `tracked-repos.yaml` at the
# repo root — and a missing default file is a no-op. If explicitly set, the
# file must exist or startup fails loud. See tracked-repos.yaml.example for
# the format.
# SEED_REPO_FILE_PATH=tracked-repos.yaml

# Cron schedules (override only if the defaults are too tight for your setup).
# SYNC_MEMBERS_CRON=*/10 * * * *
# SYNC_REPOS_CRON=*/5 * * * *
# SYNC_COMMITS_CRON=*/15 * * * *

# First-run cap on commit backfill per repo (no effect on delta runs).
# COMMITS_BACKFILL_MAX_PAGES=5
# COMMITS_BACKFILL_SINCE=               # ISO 8601 (e.g. 2026-01-01) or empty
# COMMIT_SYNC_CONCURRENCY=3
# COMMIT_SYNC_BUDGET_THRESHOLD=20

# --- Frontend ---
VITE_API_BASE_URL=https://bbstat.localhost:8443
VITE_DEV_PORT=5173
