# --- Backend ---
NODE_ENV=development
BACKEND_HOST=bbstat.localhost
BACKEND_PORT=8443

# TLS toggle for the host workflow. Set both to `off` for the local HTTP
# workflow (browsers block mixed content, so the two must flip together).
# In the containerized stack these are ignored — the reverse proxy is the
# TLS edge there.
# BACKEND_TLS=on
# FRONTEND_TLS=on

# Path to local TLS material (relative to repo root). Default works out of the box.
TLS_KEY_PATH=etc/tls/server.key
TLS_CERT_PATH=etc/tls/server.crt

# Postgres
# Container exposes :5432 INSIDE Docker but binds 127.0.0.1:15432 on the host
# (default). Override via POSTGRES_HOST_PORT below if you need a different port.
DATABASE_URL=postgres://bbstat:bbstat@localhost:15432/bbstat

# Redis (user summary cache only) — same host-port pattern.
REDIS_URL=redis://localhost:16379

# Host-side port bindings for the docker-compose dev stack. Picked to avoid
# collisions with a host-installed postgres/redis or with another project's
# Traefik / dev containers bound to the standard ports. If you change the
# DB / Redis ports, also update the host:port in DATABASE_URL / REDIS_URL
# above. Traefik's container-side ports stay 80/443; only the host binding
# moves. Flip to 80/443 if bbstat is the only reverse-proxy stack you run.
# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
# TRAEFIK_HTTP_HOST_PORT=18080
# TRAEFIK_HTTPS_HOST_PORT=18443

# BitBucket API (ingest-time only — never proxied to the request path)
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=
BITBUCKET_AUTH_EMAIL=
BITBUCKET_AUTH_TOKEN=
# Soft cap on outbound BitBucket calls per rolling hour (BB Cloud limit ≈ 1000).
BITBUCKET_HOURLY_CALL_BUDGET=1000
# Minimum interval between successive BB calls. BB's hourly cap hides a
# sub-second burst limiter that 429s above ~2-3 calls/sec; 400ms keeps us
# safely under it. Set to 0 to disable.
BITBUCKET_MIN_CALL_INTERVAL_MS=400
# Hard ceiling on adaptive pacing. Each observed 429 doubles the current
# interval (400 → 800 → 1600 → 3200 by default), capped here. When pacing
# hits this ceiling and 429s persist, the BB client's retries exhaust and
# the commits/deepen tick aborts cleanly, deferring remaining repos to
# the next cron firing.
BITBUCKET_MAX_CALL_INTERVAL_MS=3200

# Path to the curated tracked-repo seed list (YAML). Relative paths resolve
# against the repo root. If unset, defaults to `tracked-repos.yaml` at the
# repo root — and a missing default file is a no-op. If explicitly set, the
# file must exist or startup fails loud. See tracked-repos.yaml.example for
# the format.
# SEED_REPO_FILE_PATH=tracked-repos.yaml

# Cron schedules (override only if the defaults are too tight for your setup).
# SYNC_MEMBERS_CRON=*/10 * * * *
# SYNC_REPOS_CRON=*/5 * * * *
# SYNC_COMMITS_CRON=*/15 * * * *

# Auto-track workspace repos (off by default). When true, the repos-cron sweep
# walks GET /repositories/<workspace> by updated_on and tracks untracked repos;
# preview with `POST /api/admin/sync/discover-repos` (dry-run default).
# REPO_DISCOVERY_ENABLED=false

# First-run cap on commit backfill per repo (no effect on delta runs).
# COMMITS_BACKFILL_MAX_PAGES=5
# COMMITS_BACKFILL_SINCE=               # ISO 8601 (e.g. 2026-01-01) or empty
# COMMIT_SYNC_CONCURRENCY=3
# COMMIT_SYNC_BUDGET_THRESHOLD=20

# --- Frontend ---
VITE_API_BASE_URL=https://bbstat.localhost:8443
VITE_DEV_PORT=5173
# Address surfaced as the mailto link in the global page footer.
VITE_CONTACT_EMAIL=zobayer@tigerit.com
