# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
build/
.vite/
.cache/
.turbo/
.parcel-cache/

# --- TypeScript ---
*.tsbuildinfo

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors / IDEs ---
# Per-developer prefs are private; a small allowlist of shared editor config
# is committed (Vue/TS plugin nudges so a fresh clone "just works" in VSCode).
.editorconfig
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~

# --- Coding-agent local state ---
# `.claude/settings.local.json` is a per-developer permission allowlist full of
# machine-specific absolute paths — private, same rationale as .vscode/* above.
# A shared `.claude/settings.json` is allowlisted for if/when we want committed
# project-wide agent config. The root CLAUDE.md is committed and unaffected.
.claude/*
!.claude/settings.json

# --- OS metadata ---
.DS_Store
Thumbs.db

# --- Environment files (examples are committed) ---
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.docker
!.env.example
!.env.docker.example

# --- Local TLS material ---
# Per-developer self-signed CA + server cert. See CLAUDE.md / etc/tls/README.
etc/tls/*
!etc/tls/server.san
!etc/tls/README.md

# --- Curated tracked-repo seed list (per-developer; example is committed) ---
tracked-repos.yaml
!tracked-repos.yaml.example

# --- Misc ---
*.tmp
*.bak
reports/

# --- Database dumps (per-developer; never committed) ---
bbstat-data-*.sql
*.tar.gz
*.tar
*.dump
dump/
