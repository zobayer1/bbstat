{
  "name": "@bbstat/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:sync": "tsx watch --env-file-if-exists=../../.env src/sync/index.ts",
    "dev:resync": "tsx --env-file-if-exists=../../.env src/anonymous-sweep-main.ts",
    "doctor": "tsx --env-file-if-exists=../../.env src/scripts/doctor.ts",
    "rebuild:rollups": "tsx --env-file-if-exists=../../.env src/scripts/rebuild-rollups.ts",
    "recompute:user-scores": "tsx --env-file-if-exists=../../.env src/scripts/recompute-user-scores.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "start:sync": "node --env-file-if-exists=../../.env dist/sync/index.js",
    "start:migrate": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.1",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "picomatch": "^4.0.4",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/picomatch": "^4.0.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
