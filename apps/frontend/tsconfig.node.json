{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    // This project only typechecks the Vite/Vitest config files — it's not
    // emitted anywhere downstream, and without this `vue-tsc -b` writes
    // vite.config.js / vitest.config.js next to their .ts sources.
    "noEmit": true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
